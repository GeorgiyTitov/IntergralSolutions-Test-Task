# Copy this file to .env and supply your own TMDB credentials.
# .env is local configuration and is excluded from Git.
# The read access token is preferred for Bearer authentication.
TMDB_READ_ACCESS_TOKEN=
# Optional alternative credential for TMDB API v3.
TMDB_API_KEY=

# Android emulator reaches the host computer through this address.
BACKEND_URL=http://10.0.2.2:8080
